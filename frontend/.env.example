# ─── API ─────────────────────────────────────────────────────
# Development: leave as localhost (Next.js rewrite proxy handles /api → backend)
# Production:  set to your deployed backend URL
NEXT_PUBLIC_API_URL=https://print-backend-chi.vercel.app/api

# ─── STRIPE (public key only — secret key stays in backend) ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ─── SENTRY ──────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
